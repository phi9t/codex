# =============================================================================
# Dynamo + SGLang Infrastructure Configuration
# =============================================================================
# Copy this file to .env and adjust values for your setup.
#   cp .env.example .env

# -- SGLang Image -------------------------------------------------------------
# Pin the SGLang container image version. Change to upgrade SGLang.
SGLANG_IMAGE_TAG=v0.4.6

# -- Model Configuration -----------------------------------------------------
# HuggingFace model ID. Must match a model supported by SGLang.
# Examples: Qwen/Qwen2.5-Coder-7B-Instruct, meta-llama/Llama-3.1-8B-Instruct
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# HuggingFace token for gated models (e.g. Llama). Leave empty for public models.
HF_TOKEN=

# -- SGLang Worker Settings ---------------------------------------------------
# Number of GPUs for tensor parallelism (must not exceed available GPUs).
TENSOR_PARALLEL_SIZE=1

# Fraction of GPU memory reserved for KV cache (0.0-1.0).
# Lower values leave more room for the model; raise if you see OOM.
SGLANG_MEM_FRACTION=0.85

# Maximum concurrent requests in the running batch.
SGLANG_MAX_RUNNING_REQUESTS=64

# Chunked prefill token budget per step. Lower values reduce TTFT variance.
SGLANG_CHUNKED_PREFILL_SIZE=8192

# SGLang HTTP server port inside the container.
SGLANG_PORT=30000

# -- Agentic Workload / Cache Settings ---------------------------------------
# Radix cache eviction policy: "priority" preserves high-value session prefixes.
SGLANG_RADIX_EVICTION_POLICY=priority

# HiCache write policy: "write_through" ensures host-tier KV is always current.
SGLANG_HICACHE_WRITE_POLICY=write_through

# Tool call parser: matches model family for structured tool/function call output.
# qwen25 = Qwen2.5-Coder series; llama3 = Llama-3.x; mistral = Mistral series.
SGLANG_TOOL_CALL_PARSER=qwen25

# Watchdog timeout (seconds): restarts the worker if inference stalls.
SGLANG_WATCHDOG_TIMEOUT=300

# -- Dynamo Frontend ----------------------------------------------------------
# Port exposed on the host for the Dynamo frontend API.
DYNAMO_FRONTEND_PORT=8080

# -- Infrastructure -----------------------------------------------------------
# etcd port for service discovery.
ETCD_PORT=2379

# NATS port for event plane.
NATS_PORT=4222

# -- HuggingFace Cache -------------------------------------------------------
# Host path for HuggingFace model cache. Uses a named Docker volume by default.
# Uncomment to use a host directory instead:
# HF_CACHE_DIR=~/.cache/huggingface
