# HuggingFace token secret for accessing gated models (e.g. Llama, Gemma).
# Public models like Qwen2.5-Coder do not need this secret.
#
# Usage:
#   cp infra/k8s/hf-secret.yaml.example infra/k8s/hf-secret.yaml
#   # Edit hf-secret.yaml and replace YOUR_HF_TOKEN_HERE with your token
#   kubectl apply -f infra/k8s/hf-secret.yaml
#
# IMPORTANT: do NOT commit hf-secret.yaml to version control.
# Add it to .gitignore: echo "infra/k8s/hf-secret.yaml" >> .gitignore
apiVersion: v1
kind: Secret
metadata:
  name: hf-credentials
  namespace: codex-inference
type: Opaque
stringData:
  token: "YOUR_HF_TOKEN_HERE"
